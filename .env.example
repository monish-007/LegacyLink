# Trusted SOAP sources are configured by the server, never accepted as browser URLs.
# Use HTTPS outside local development.
LEGACYLINK_SOURCES_JSON=[{"id":"demo-bank","url":"http://host.docker.internal:8085/GetCustomerData","method":"POST"}]
LEGACYLINK_ALLOW_HTTP=true

# Optional request headers and SOAP request body are referenced by environment name.
# LEGACY_BANK_HEADERS_JSON={"Authorization":"Bearer replace-me"}
# LEGACY_BANK_REQUEST_XML=<soapenv:Envelope>...</soapenv:Envelope>

# Optional Supabase audit store. Keep this service-role key server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Older projects may instead use SUPABASE_SERVICE_ROLE_KEY. Prefer a new secret key.
